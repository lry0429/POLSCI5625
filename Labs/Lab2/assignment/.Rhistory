## Required correctness checks
x_test <- c(0, 1)
y_test <- c(0, 0.5, 2)
expected <- matrix(
c(0, 0.5, 2,
1, 0.5, 1),
nrow = 2,
byrow = TRUE
)
task3_test <- thresholded_distance_loop(x_test, y_test, threshold = 0.5)
task4_test <- thresholded_distance_vectorized(x_test, y_test, threshold = 0.5)
task5_test <- thresholded_distance_sparse(x_test, y_test, threshold = 0.5)
stopifnot(
isTRUE(all.equal(task3_test, expected, tolerance = 1e-12)),
isTRUE(all.equal(task4_test, expected, tolerance = 1e-12)),
isTRUE(all.equal(task5_test, expected, tolerance = 1e-12)),
identical(dim(task3), dim(task4), dim(task5), c(3000L,5000L)),
isTRUE(all(task3 == 0 | task3 >= 0.5) & all(task4 == 0 | task4 >= 0.5),
tolerance = 1e-12),
isTRUE(all.equal(task3[task3 == 0.5], task4[task4 == 0.5], task5[task5 == 0.5],
0.5, tolerance = 1e-12)),
length(task5[task5 > 0]) == length(task4[task4 > 0])
)
task4_test <- thresholded_distance_vectorized(x_test, y_test, threshold = 0.5)
isTRUE(all.equal(task4_test, expected, tolerance = 1e-12)),
isTRUE(all.equal(task4_test, expected, tolerance = 1e-12))
identical(dim(task3), dim(task4), dim(task5), c(3000L,5000L))
length(task5[task5 > 0]) == length(task4[task4 > 0])
isTRUE(all.equal(task5_test, expected, tolerance = 1e-12))
source(file.path("R", "lab2_task3-5.r"))
## Required correctness checks
x_test <- c(0, 1)
y_test <- c(0, 0.5, 2)
expected <- matrix(
c(0, 0.5, 2,
1, 0.5, 1),
nrow = 2,
byrow = TRUE
)
task3_test <- thresholded_distance_loop(x_test, y_test, threshold = 0.5)
task4_test <- thresholded_distance_vectorized(x_test, y_test, threshold = 0.5)
task5_test <- thresholded_distance_sparse(x_test, y_test, threshold = 0.5)
stopifnot(
isTRUE(all.equal(task3_test, expected, tolerance = 1e-12)),
isTRUE(all.equal(task4_test, expected, tolerance = 1e-12)),
isTRUE(all.equal(task5_test, expected, tolerance = 1e-12)),
identical(dim(task3), dim(task4), dim(task5), c(3000L,5000L)),
isTRUE(all(task3 == 0 | task3 >= 0.5) & all(task4 == 0 | task4 >= 0.5),
tolerance = 1e-12),
isTRUE(all.equal(task3[task3 == 0.5], task4[task4 == 0.5], task5[task5 == 0.5],
0.5, tolerance = 1e-12)),
length(task5[task5 > 0]) == length(task4[task4 > 0])
)
isTRUE(all.equal(task4_test, expected, tolerance = 1e-12))
isTRUE(all.equal(task5_test, expected, tolerance = 1e-12))
task3_test <- thresholded_distance_loop(x_test, y_test, threshold = 0.5)
task4_test <- thresholded_distance_vectorized(x_test, y_test, threshold = 0.5)
task5_test <- thresholded_distance_sparse(x_test, y_test, threshold = 0.5)
stopifnot(
isTRUE(all.equal(task3_test, expected, tolerance = 1e-12)),
isTRUE(all.equal(task4_test, expected, tolerance = 1e-12)),
isTRUE(all.equal(as.matrix(task5_test), expected, tolerance = 1e-12)),
identical(dim(task3), dim(task4), dim(task5), c(3000L,5000L)),
isTRUE(all(task3 == 0 | task3 >= 0.5) & all(task4 == 0 | task4 >= 0.5),
tolerance = 1e-12),
isTRUE(all.equal(task3[task3 == 0.5], task4[task4 == 0.5], task5[task5 == 0.5],
0.5, tolerance = 1e-12)),
length(task5[task5 > 0]) == length(task4[task4 > 0])
)
stopifnot(
isTRUE(all.equal(task3_test, expected, tolerance = 1e-12)),
isTRUE(all.equal(task4_test, expected, tolerance = 1e-12)),
isTRUE(all.equal(as.matrix(task5_test), expected, tolerance = 1e-12)),
identical(dim(task3), dim(task4), dim(task5), c(3000L,5000L)),
isTRUE(all(task3 == 0 | task3 >= 0.5) & all(task4 == 0 | task4 >= 0.5)),
isTRUE(all.equal(task3[task3 == 0.5], task4[task4 == 0.5], task5[task5 == 0.5],
0.5, tolerance = 1e-12)),
length(task5[task5 > 0]) == length(task4[task4 > 0])
)
cat("PASS: the three tasks have the correct results.\n")
## Required performance comparison
time_task3 <- system.time(task3)[["elapsed"]]
time_task4 <- system.time(task4)[["elapsed"]]
time_task5 <- system.time(task5)[["elapsed"]]
size_task3 <- as.numeric(object.size(task3))
size_task4 <- as.numeric(object.size(task4))
size_task5 <- as.numeric(object.size(task5))
tab <- data.frame(
method = c("Task 3: loop",
"Task 4: vectorized",
"Task 5: sparse"),
elapsed_seconds = c(
time_task3,
time_task4,
time_task5
),
stored_result_bytes = c(
size_task3,
size_task4,
size_task5
),
nonzero_entries = c(
Matrix::nnzero(task3),
Matrix::nnzero(task4),
Matrix::nnzero(task5)
)
)
tab
time_gain <- time_task3 / time_task4
time_gain
time_reduction_percent <- 100 * (1 - time_task4 / time_task3)
time_reduction_percent
memory_reduction_percent <-
100 * (1 - as.numeric(object.size(task5)) /
as.numeric(object.size(task4)))
memory_reduction_percent
dir.create("results", showWarnings = FALSE)
write.csv(
tab,
file = file.path("results", "comparison_table.csv"),
row.names = FALSE
)
