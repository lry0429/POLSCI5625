aidGDP <- read.csv("https://www.dropbox.com/scl/fi/0920cqfh1n2tcj9s4cowh/KJBdata.csv?rlkey=wib4erm026uzwweyhcf5b5hx1&dl=1")
library(tidyverse)
aidGDP <- aidGDP %>%
filter(!is.na(aiddep), !is.na(gnipc))
nrow(aidGDP)
library(ggplot2)
aidGDP %>% filter(aiddep == 1) %>%
ggplot(aes(gnipc))
library(ggplot2)
aidGDP %>% filter(aiddep == 1) %>%
ggplot(aes(gnipc)) +
geom_histogram()
?geom_histogram
library(ggplot2)
aidGDP %>% filter(aiddep == 1) %>%
ggplot(aes(gnipc)) +
geom_histogram(fill = "coral1", alpha = .6, boundary = 0)
?geom_histogram
library(ggplot2)
aidGDP %>% filter(aiddep == 1) %>%
ggplot(aes(gnipc)) +
geom_histogram(fill = "coral1", alpha = .6, boundary = 0, binwidth = 100)+
labs(title = "Aid-Dependent Countries: Income Per Capita")
?geom_histogram
ggplot(aidGDP, aes(gnpc)) +
geom_histogram(alpha = 0.6, boundary = 0, binwidth = 100) +
facet_wrap(~aiddep)
ggplot(aidGDP, aes(gnipc)) +
geom_histogram(alpha = 0.6, boundary = 0, binwidth = 100) +
facet_wrap(~aiddep)
ggplot(aidGDP, aes(gnipc, fill = as.factor(aiddep))) +
geom_histogram(alpha = 0.6, boundary = 0, binwidth = 100) +
facet_wrap(~aiddep)
ggplot(aidGDP, aes(gnipc, fill = as.factor(aiddep))) +
geom_histogram(alpha = 0.6, boundary = 0, binwidth = 100) +
facet_wrap(~aiddep) +
scale_fill_manual(values = c("coral1", "deepskyblue"))
ggplot(aidGDP, aes(gnipc, fill = as.factor(aiddep))) +
geom_histogram(alpha = 0.6, boundary = 0, binwidth = 100) +
scale_fill_manual(values = c("coral1", "deepskyblue"))
ggplot(aidGDP, aes(gnipc, fill = as.factor(aiddep))) +
geom_histogram(alpha = 0.6, boundary = 0, binwidth = 100, position = "identity") +
scale_fill_manual(values = c("coral1", "deepskyblue"))
